# ── Skeo LMS backend ──
PORT=4200

# SAME Atlas cluster as the marketing site. This service only touches lms_*
# collections, so it never collides with leads/orders/users.
# Copy the exact MONGODB_URI you use for the marketing backend.
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# Secret for signing LMS Bearer tokens — set to a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Base URL of the LMS frontend (for CORS + password-reset links).
SKEO_APP_URL=http://localhost:5174

# Optional first-admin credentials for the seed script.
SKEO_SEED_EMAIL=admin@skeo.in
SKEO_SEED_PASSWORD=ChangeMe123!

# SMTP email (until set, reset links log to the console). Works with Gmail
# (app password), SendGrid, Mailgun, Zoho, etc. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Skeo LMS <no-reply@example.com>

# Google Drive API key (public-data only, no OAuth) — used to verify a
# student's submitted Drive folder is public and inspect its contents.
# Create one at console.cloud.google.com → APIs & Services → Credentials,
# restricted to the Drive API. Until set, Drive-link submissions come back
# CHECK_FAILED instead of being verified.
GOOGLE_DRIVE_API_KEY=
