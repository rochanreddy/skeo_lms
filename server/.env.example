# ── Skeo LMS backend ──
PORT=4200

# Skeo own Atlas cluster (project: Sachin's Org / Project 0). Get this from
# Atlas -> Database -> Connect -> Drivers -> Node.js.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.krcoyqg.mongodb.net/skeo?retryWrites=true&w=majority&appName=Cluster0

# Secret for signing LMS Bearer tokens — set to a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Base URL of the LMS frontend (for CORS + password-reset links).
SKEO_APP_URL=http://localhost:5175

# Optional first-admin credentials for the seed script.
SKEO_SEED_EMAIL=admin@skeo.in
SKEO_SEED_PASSWORD=ChangeMe123!

# ── Email ──
#
# WHO THE MAIL COMES FROM. Set this. Everything else is a fallback and the
# fallbacks are worse: without it the sender becomes whatever mailbox the SMTP
# credentials belong to, or Resend’s shared onboarding@resend.dev.
#
# The domain here has to be one the provider has verified — a domain added in
# the Resend dashboard, or a Workspace "send mail as" alias. An unverified
# domain is not a soft failure: Resend rejects the send outright, and SMTP that
# does deliver lands in spam, because SPF and DKIM for skeoai.com do not cover
# a server that is not listed in its DNS.
MAIL_FROM=skeo <support@skeoai.com>

# Resend — the transport to use on a managed host. Render and most others
# firewall outbound 25/465/587, and the failure is not an auth error anyone
# would notice: the connection hangs until it times out, taking the request
# with it. Port 443 is never blocked. Leave the SMTP block below empty if this
# is set; it is tried first either way.
RESEND_API_KEY=

# SMTP — fine on a box you control. Until one of these two is configured,
# reset links and certificate mail log to the console instead of sending.
# Works with Gmail (app password), SendGrid, Mailgun, Zoho, etc.
# Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Older name for MAIL_FROM, still honoured. Prefer MAIL_FROM above.
SMTP_FROM=

# Google Drive API key (public-data only, no OAuth) — used to verify a
# student's submitted Drive folder is public and inspect its contents.
# Create one at console.cloud.google.com → APIs & Services → Credentials,
# restricted to the Drive API. Until set, Drive-link submissions come back
# CHECK_FAILED instead of being verified.
GOOGLE_DRIVE_API_KEY=

# VdoCipher — DRM video hosting for lesson videos. The API secret from
# dashboard.vdocipher.com → Config → API credentials. It stays on the server:
# the client only ever receives a 5-minute playback OTP for a video it is
# entitled to. Until this is set, the VdoCipher option is hidden in the
# curriculum editor and /videos answers 503.
VDOCIPHER_API_SECRET=

# Burn the viewer's name and email over the picture (on | off). On by default —
# it is what makes a screen recording traceable back to one account.
VDOCIPHER_WATERMARK=on

# The job pipeline's database — READ ONLY. The board reads jobs scraped by
# skeo-job-pipeline, which lives on its own Atlas cluster and is the only
# thing that writes there. Use the jobs_reader user, never the pipeline's own
# credentials: this service must never be able to damage that feed.
# Until this is set, the board shows only the openings admins posted by hand.
JOBS_MONGODB_URI=
