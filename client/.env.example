# Base URL of the LMS backend API. The path is /api/skeo on both — /api/lms is
# the OLD service and 404s here.
# Local: http://localhost:4200/api/skeo
# Prod:  https://<your-render-app>.onrender.com/api/skeo
#
# Required in production. Without it the app falls back to localhost and every
# request fails, so set it in the Vercel project before the first deploy.
VITE_API_URL=http://localhost:4200/api/skeo
